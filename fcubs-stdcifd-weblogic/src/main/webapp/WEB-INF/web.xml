<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
    <display-name>STDCIFD WebLogic Clone Gateway</display-name>

    <servlet>
        <servlet-name>CustomerSoapServlet</servlet-name>
        <servlet-class>com.example.fcubs.stdcifd.web.CustomerSoapServlet</servlet-class>
        <init-param>
            <param-name>functionId</param-name>
            <param-value>STDCIFD</param-value>
        </init-param>
        <init-param>
            <param-name>serviceName</param-name>
            <param-value>FCUBSCustomerService</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerSoapServlet</servlet-name>
        <url-pattern>/api/fcubs/customer-soap</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CustomerSoapServlet</servlet-name>
        <url-pattern>/soap/STDCIFD</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SessionServlet</servlet-name>
        <servlet-class>com.example.fcubs.stdcifd.web.SessionServlet</servlet-class>
        <load-on-startup>2</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>SessionServlet</servlet-name>
        <url-pattern>/api/fcubs/session</url-pattern>
    </servlet-mapping>

    <resource-ref>
        <description>WebLogic JDBC DataSource for the STDCIFD clone schema</description>
        <res-ref-name>jdbc/FCUBSDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
        <res-sharing-scope>Shareable</res-sharing-scope>
    </resource-ref>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Customer CIF application</web-resource-name>
            <url-pattern>/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>CIF_USER</role-name>
        </auth-constraint>
        <user-data-constraint>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>

    <login-config>
        <auth-method>BASIC</auth-method>
        <realm-name>FCUBS Clone Security Realm</realm-name>
    </login-config>

    <security-role><role-name>CIF_USER</role-name></security-role>
    <security-role><role-name>CIF_MAKER</role-name></security-role>
    <security-role><role-name>CIF_CHECKER</role-name></security-role>

    <session-config>
        <session-timeout>15</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>true</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
</web-app>
